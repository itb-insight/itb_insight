# ─── Supabase ───────────────────────────────────────────────────────────────
# Project URL + anon (public) key: Supabase Dashboard → Project Settings → API.
# Safe to eT_PUBxpose to the browser (NEXLIC_*).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-KEY"

# Service-role key: same API settings page → service_role secret.
# SERVER-ONLY. Never prefix with NEXT_PUBLIC. Bypasses RLS — used by API routes
# to perform validated writes (team create/join, registration submit, tickets).
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"

# ─── App ────────────────────────────────────────────────────────────────────
# Public origin, used to build OAuth / magic-link redirect URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Comma-separated admin email allowlist (fallback when admin_roles table is empty).
ADMIN_EMAILS=""
