# ─── Supabase ───────────────────────────────────────────────────────────────
# Project URL + anon (public) key: Supabase Dashboard → Project Settings → API.
# Safe to expose to the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-KEY"

# Service-role key: same API settings page → service_role secret.
# SERVER-ONLY. Never prefix with NEXT_PUBLIC. Bypasses RLS — used by API routes
# to perform validated writes (team create/join, registration submit, tickets).
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"

# ─── App ────────────────────────────────────────────────────────────────────
# Public origin, used to build OAuth / magic-link redirect URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Comma-separated admin email allowlist (fallback when admin_roles table is empty).
ADMIN_EMAILS=""

# ─── Midtrans Payment Gateway (CMP-10–CMP-16) ────────────────────────────────
# Server Key (SERVER-ONLY, never expose to client)
MIDTRANS_SERVER_KEY="YOUR-MIDTRANS-SERVER-KEY"
# Client Key (Safe for browser / Snap SDK)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="YOUR-MIDTRANS-CLIENT-KEY"
# Set to 'true' for production, 'false' for sandbox
MIDTRANS_IS_PRODUCTION="false"

# MAINTENANCE MODE
MAINTENANCE_SITE = false
MAINTENANCE_PAGES= '/competition2, /events2'
MAINTENANCE_BYPASS_SECRET=
# ─── Cloudflare Turnstile (feedback anti-spam) ──────────────────────────────
# Cloudflare dashboard → Turnstile → add widget (managed mode) for the site's domains.
# Set BOTH or NEITHER. When the secret is set, every feedback submission must pass Turnstile.
# The site key also adds the widget to magic-link login/sign-up, so you can turn on
# Supabase → Authentication → Attack Protection → Captcha (Turnstile, same secret).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ─── Feedback testing ───────────────────────────────────────────────────────
# "true" treats every feedback form as active and open (ignores is_active, opens_at,
# closes_at) for manual testing. Ignored when NODE_ENV=production (next start, Vercel).
FEEDBACK_FORCE_OPEN=false
# COUNTDOWN-ONLY MODE
# true = every page shows public/countdown.html, every API / non-GET request is 503. No bypass.
# Still reachable: /feedback/<slug> (+ its API), /login, /signup, /auth/callback.
# The navbar then hides Event / Competition / Map / search / Dashboard.
COUNTDOWN_ONLY=false

# REGISTER BUTTON PER COMPETITION
# The "Register Now" button on /competition/<slug> is CLOSED by default
# ("Pendaftaran Ditutup"). Set to true to open it for that competition.
# Read on the server; redeploy after changing it on Vercel.
REGISTER_OPEN_MOR=false
REGISTER_OPEN_BPC=false
REGISTER_OPEN_OE=false
REGISTER_OPEN_SAR=false

# ─── Maps ───────────────────────────────────────────────────────────────────
# "true" disables every map feature: /event-map shows the maintenance page (503),
# and the Map links (navbar, mobile menu, footer, Insight Festival "Lihat Peta",
# "Buka Peta" on event pages) are greyed out with a "Coming Soon!" pill.
# NEXT_PUBLIC_ = inlined at build time: restart dev / redeploy after changing it.
NEXT_PUBLIC_MAPS_DISABLED=true

# ─── Event locations ────────────────────────────────────────────────────────
# "true" shows "To be Announced" instead of the location on every event (/event list,
# /event/<slug> venue + "other events" cards, dashboard event list, JSON-LD).
# Server-only (not NEXT_PUBLIC): redeploy after changing it on Vercel.
EVENTS_LOCATION_TBA=false

# ─── Self check-in geofence ─────────────────────────────────────────────────
# POST /api/check-in/self only works from inside this circle (src/lib/geofence.ts).
# Leave VENUE_LAT / VENUE_LNG empty to keep self check-in off (503). Decimal degrees.
VENUE_LAT=
VENUE_LNG=
VENUE_RADIUS_M=300
VENUE_MAX_ACCURACY_M=100

# ─── Booth presence (opt-in, D-day) ─────────────────────────────────────────
# Uses the VENUE_* circle above as the event zone: unset = presence off. See src/lib/presence.ts.
# Booth zone: the booth area inside the venue, where burst sampling runs. Unset = single fixes.
BOOTH_ZONE_LAT=
BOOTH_ZONE_LNG=
BOOTH_ZONE_RADIUS_M=
# Fixes less precise than this never match a booth (metres).
BOOTH_MAX_ACCURACY_M=25
# EXPERIMENTAL: 8 fixes 2 s apart per ping in the booth zone. Keep only if the field test shows it helps.
PRESENCE_BURST=false
# Jakarta dates presence runs (comma-separated). Empty = D-Day and dated events. Add a test day here.
PRESENCE_DATES=
# Jakarta hours, start-end (end exclusive).
PRESENCE_HOURS=6-20
# Testing: admin and staff accounts run presence any day and hour, without a gate check-in,
# and see the debug readout. Consent and zones still apply. Turn off after testing.
PRESENCE_TEST_MODE=false

NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_REGION="us"
POSTHOG_PROJECT_ID="42"
POSTHOG_PERSONAL_API_KEY="phx_..."