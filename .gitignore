# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Jetbrains
.idea/

# Local agent system (intentionally kept outside Git).
/.opencode/
/.agents/
/.claude/
/tools/codebase-memory-mcp.cmd

# Supabase CLI state (project ref, pooler URL) and personal notes: local only.
/supabase/.temp/
/notes.md

/temp
# Event photo/video originals (300+ MB). Web versions live in public/events/.
/design-sources/events/
