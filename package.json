{
  "name": "itb-insight",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:prune": "eslint --prune-suppressions",
    "test": "vitest run",
    "test:guardrails": "vitest run tests/guardrails",
    "typecheck": "next typegen && tsc --noEmit",
    "audit:prod": "node scripts/audit-prod.mjs",
    "import:oe": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/import-oe-registrations.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "jsqr": "^1.4.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.23.0",
    "maplibre-gl": "^5.24.0",
    "next": "^16.4.6",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-map-gl": "^8.1.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.185.1",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
